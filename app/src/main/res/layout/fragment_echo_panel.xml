<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/echo_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:cardCornerRadius="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <TextView
                android:id="@+id/knob_time_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingBottom="6dp"
                android:text="@string/echo_sec_delay_time"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Flow reflows the controls to whatever width is available, so the
                 panel adapts from a phone to a wide tablet without clipping. -->
            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="knob_time,switch_keep_pitch,knob_smoothing,knob_offset"
                app:flow_wrapMode="chain"
                app:flow_horizontalStyle="packed"
                app:flow_horizontalGap="6dp"
                app:flow_verticalGap="6dp"
                app:flow_verticalAlign="center"
                app:layout_constraintTop_toBottomOf="@id/knob_time_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_time"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="TIME"
            app:knobMin="1"
            app:knobMax="2500"
            app:knobValue="350"
            app:knobUnit="ms"
            app:knobPrecision="0"
            app:knobLogScale="true" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_keep_pitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="@string/echo_keep_pitch" />
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_smoothing"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="SMOOTHING"
            app:knobMin="0"
            app:knobMax="100"
            app:knobValue="20"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_offset"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="OFFSET"
            app:knobMin="-200"
            app:knobMax="200"
            app:knobValue="0"
            app:knobUnit="ms"
            app:knobPrecision="0"
            app:knobLogScale="false" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:cardCornerRadius="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <TextView
                android:id="@+id/group_model_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingBottom="6dp"
                android:text="@string/echo_sec_delay_model"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Flow reflows the controls to whatever width is available, so the
                 panel adapts from a phone to a wide tablet without clipping. -->
            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="group_model,knob_stereo"
                app:flow_wrapMode="chain"
                app:flow_horizontalStyle="packed"
                app:flow_horizontalGap="6dp"
                app:flow_verticalGap="6dp"
                app:flow_verticalAlign="center"
                app:layout_constraintTop_toBottomOf="@id/group_model_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/group_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/model_mono"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:text="@string/echo_model_mono" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/model_stereo"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:text="@string/echo_model_stereo" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/model_pingpong"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:text="@string/echo_model_pingpong" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/model_off"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:text="@string/echo_filter_off" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_stereo"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="STEREO"
            app:knobMin="0"
            app:knobMax="100"
            app:knobValue="50"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:cardCornerRadius="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <TextView
                android:id="@+id/knob_feedback_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingBottom="6dp"
                android:text="@string/echo_sec_feedback"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Flow reflows the controls to whatever width is available, so the
                 panel adapts from a phone to a wide tablet without clipping. -->
            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="knob_feedback,group_filter,knob_cutoff,knob_res,knob_smp_rate,knob_bits"
                app:flow_wrapMode="chain"
                app:flow_horizontalStyle="packed"
                app:flow_horizontalGap="6dp"
                app:flow_verticalGap="6dp"
                app:flow_verticalAlign="center"
                app:layout_constraintTop_toBottomOf="@id/knob_feedback_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_feedback"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="LEVEL"
            app:knobMin="0"
            app:knobMax="100"
            app:knobValue="40"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/group_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_lp"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:text="@string/echo_filter_lp_short" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_hp"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:text="@string/echo_filter_hp_short" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_bp"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:text="@string/echo_filter_bp_short" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_off"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:text="@string/echo_filter_off" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_cutoff"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="CUTOFF"
            app:knobMin="20"
            app:knobMax="20000"
            app:knobValue="12000"
            app:knobUnit="Hz"
            app:knobPrecision="0"
            app:knobLogScale="true" />
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_res"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="RES"
            app:knobMin="0"
            app:knobMax="100"
            app:knobValue="10"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_smp_rate"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="SMP RATE"
            app:knobMin="1"
            app:knobMax="100"
            app:knobValue="100"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_bits"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="BITS"
            app:knobMin="1"
            app:knobMax="24"
            app:knobValue="24"
            app:knobUnit="bit"
            app:knobPrecision="0"
            app:knobLogScale="false" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:cardCornerRadius="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <TextView
                android:id="@+id/knob_mod_rate_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingBottom="6dp"
                android:text="@string/echo_sec_modulation"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Flow reflows the controls to whatever width is available, so the
                 panel adapts from a phone to a wide tablet without clipping. -->
            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="knob_mod_rate,knob_mod_time,knob_mod_cutoff"
                app:flow_wrapMode="chain"
                app:flow_horizontalStyle="packed"
                app:flow_horizontalGap="6dp"
                app:flow_verticalGap="6dp"
                app:flow_verticalAlign="center"
                app:layout_constraintTop_toBottomOf="@id/knob_mod_rate_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_mod_rate"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="RATE"
            app:knobMin="0"
            app:knobMax="10"
            app:knobValue="0"
            app:knobUnit="Hz"
            app:knobPrecision="1"
            app:knobLogScale="false" />
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_mod_time"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="TIME"
            app:knobMin="0"
            app:knobMax="100"
            app:knobValue="0"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_mod_cutoff"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="CUTOFF"
            app:knobMin="0"
            app:knobMax="100"
            app:knobValue="0"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:cardCornerRadius="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <TextView
                android:id="@+id/knob_diffusion_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingBottom="6dp"
                android:text="@string/echo_sec_diffusion"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Flow reflows the controls to whatever width is available, so the
                 panel adapts from a phone to a wide tablet without clipping. -->
            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="knob_diffusion,knob_spread"
                app:flow_wrapMode="chain"
                app:flow_horizontalStyle="packed"
                app:flow_horizontalGap="6dp"
                app:flow_verticalGap="6dp"
                app:flow_verticalAlign="center"
                app:layout_constraintTop_toBottomOf="@id/knob_diffusion_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_diffusion"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="LEVEL"
            app:knobMin="0"
            app:knobMax="100"
            app:knobValue="0"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_spread"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="SPREAD"
            app:knobMin="0"
            app:knobMax="100"
            app:knobValue="0"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:cardCornerRadius="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <TextView
                android:id="@+id/group_dist_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingBottom="6dp"
                android:text="@string/echo_sec_distortion"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Flow reflows the controls to whatever width is available, so the
                 panel adapts from a phone to a wide tablet without clipping. -->
            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="group_dist,knob_dist_level,knob_knee,knob_symmetry"
                app:flow_wrapMode="chain"
                app:flow_horizontalStyle="packed"
                app:flow_horizontalGap="6dp"
                app:flow_verticalGap="6dp"
                app:flow_verticalAlign="center"
                app:layout_constraintTop_toBottomOf="@id/group_dist_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/group_dist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dist_limit"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:text="@string/echo_dist_limit" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dist_sat"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:text="@string/echo_dist_sat" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_dist_level"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="LEVEL"
            app:knobMin="0"
            app:knobMax="100"
            app:knobValue="0"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_knee"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="KNEE"
            app:knobMin="0"
            app:knobMax="100"
            app:knobValue="50"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />
        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_symmetry"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="SYMMETRY"
            app:knobMin="-100"
            app:knobMax="100"
            app:knobValue="0"
            app:knobUnit="%"
            app:knobPrecision="0"
            app:knobLogScale="false" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:cardCornerRadius="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <TextView
                android:id="@+id/knob_input_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingBottom="6dp"
                android:text="@string/echo_sec_output"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Flow reflows the controls to whatever width is available, so the
                 panel adapts from a phone to a wide tablet without clipping. -->
            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="knob_input,knob_wet,knob_tone,knob_dry"
                app:flow_wrapMode="chain"
                app:flow_horizontalStyle="packed"
                app:flow_horizontalGap="6dp"
                app:flow_verticalGap="6dp"
                app:flow_verticalAlign="center"
                app:layout_constraintTop_toBottomOf="@id/knob_input_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <me.timschneeberger.rootlessjamesdsp.view.KnobView
            android:id="@+id/knob_input"
            android:layout_width="84dp"
            android:layout_height="98dp"
            app:knobLabel="IN"
            app:knobMin="0"
            app:knobMax="100"
            app:knobValue="100"
            app:knobUnit="%"
            app:knobPrecision="0"
