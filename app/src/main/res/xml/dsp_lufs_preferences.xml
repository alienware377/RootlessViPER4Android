<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:key="@string/key_lufs_enable"
        android:disableDependentsState="false"
        android:title="@string/lufs_enable"
        android:icon="@drawable/ic_twotone_volume_up_24dp"
        app:iconSpaceReserved="false">
        <Preference android:key="section_info" android:title="@string/section_info_title"
            android:summary="@string/lufs_info" android:persistent="false"
            app:allowDividerAbove="false" app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_lufs_target"
            android:title="@string/lufs_target"
            android:summary="@string/lufs_target_summary"
            android:defaultValue="-14"
            app:minValue="-30" app:maxValue="-5" app:unit="LUFS" app:precision="0"
            app:allowDividerAbove="false" app:updatesContinuously="true"
            app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_lufs_max_boost"
            android:title="@string/lufs_max_boost"
            android:summary="@string/lufs_max_boost_summary"
            android:defaultValue="6"
            app:minValue="0" app:maxValue="12" app:unit="dB" app:precision="0"
            app:allowDividerAbove="false" app:updatesContinuously="true"
            app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_lufs_max_cut"
            android:title="@string/lufs_max_cut"
            android:summary="@string/lufs_max_cut_summary"
            android:defaultValue="12"
            app:minValue="0" app:maxValue="24" app:unit="dB" app:precision="0"
            app:allowDividerAbove="false" app:updatesContinuously="true"
            app:showSeekBarValue="true" app:iconSpaceReserved="false"/>
        <ListPreference
            android:key="@string/key_lufs_speed"
            android:title="@string/lufs_speed"
            android:defaultValue="1"
            android:entries="@array/lufs_speeds"
            android:entryValues="@array/lufs_speeds_values"
            app:useSimpleSummaryProvider="true"
            app:allowDividerAbove="false" app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSwitchPreference
            android:key="@string/key_lufs_peak_guard"
            android:title="@string/lufs_peak_guard"
            android:summary="@string/lufs_peak_guard_summary"
            android:defaultValue="true"
            app:allowDividerAbove="false" app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>
</PreferenceScreen>
