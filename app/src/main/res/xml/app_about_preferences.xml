<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <me.timschneeberger.rootlessjamesdsp.preference.AppIconPreference
        app:selectable="false"
        app:iconSpaceReserved="false"
        app:allowDividerBelow="true" />

    <Preference
        android:title="@string/credits_version"
        android:summary="x.x.x"
        android:key="@string/key_credits_version"
        android:icon="@drawable/ic_twotone_history_24dp"
        app:allowDividerAbove="true" />

    <Preference
        android:title="@string/credits_build_info"
        android:summary="@string/value_not_set"
        android:icon="@drawable/ic_twotone_info_24dp"
        android:key="@string/key_credits_build_info" />

    <Preference
        android:title="@string/credits_project_page"
        android:summary="@string/credits_project_page_summary"
        android:icon="@drawable/ic_baseline_github_24dp">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/thepbone/RootlessJamesDSP" />
    </Preference>

    <Preference
        android:key="@string/key_credits_google_play"
        android:title="@string/credits_project_play_page"
        android:summary="@string/credits_project_play_page_summary"
        android:icon="@drawable/ic_baseline_google_play_24dp">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://play.google.com/store/apps/details?id=me.timschneeberger.rootlessjamesdsp" />
    </Preference>

    <Preference
        android:key="@string/key_credits_check_update"
        android:title="@string/credits_project_check_update"
        android:summary="@string/credits_project_check_update_summary"
        android:icon="@drawable/ic_twotone_download_24">
    </Preference>

    <Preference
        android:title="@string/credits_project_translate"
        android:summary="@string/credits_project_translate_summary"
        android:icon="@drawable/ic_twotone_translate_24dp">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://crowdin.com/project/rootlessjamesdsp" />
    </Preference>

    <PreferenceCategory
    app:title="@string/credits"
    app:iconSpaceReserved="false">
    <Preference
        android:title="@string/credits_app"
        android:summary="Tim Schneeberger (@thepbone)"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/thepbone" />
    </Preference>
    <Preference
        android:title="@string/credits_dsp"
        android:summary="James Fung (@james34602)"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/james34602" />
    </Preference>

    <Preference
        android:title="@string/credits_viper"
        android:summary="ViPER's Audio team — original ViPER4Android effect designs"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/ViPER-Audio" />
    </Preference>
    <Preference
        android:title="@string/credits_sndfilter"
        android:summary="Sean Connelly (@velipso, formerly @voidqk): sndfilter reverb, used by the Virtual room effect card, the preset reverb (MIT). Not used by the Reverberation card. The sndfilter reverb is itself based on the Progenitor2 design from Freeverb3"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/velipso/sndfilter" />
    </Preference>
    <Preference
        android:title="libbs2b"
        android:summary="Boris Mikhaylov: Bauer stereophonic-to-binaural DSP, used by the BS2B presets of the Crossfeed card (MIT)"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://bs2b.sourceforge.net/" />
    </Preference>
    <Preference
        android:title="FFTConvolver"
        android:summary="HiFi-LoFi: partitioned FFT convolution, ported to C, behind the Convolver, the equalizers, the HRTF crossfeed modes and Live programmable DSP (MIT)"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/HiFi-LoFi/FFTConvolver" />
    </Preference>
    <Preference
        android:title="Boost.Math interpolators"
        android:summary="Nick Thompson: PCHIP, makima and cubic Hermite interpolation, ported to C, used by the Multimodal equalizer and the Dynamic range compander (Boost Software License 1.0)"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/boostorg/math" />
    </Preference>
    <Preference
        android:title="smbPitchShift"
        android:summary="Stephan M. Bernsee: phase vocoder that the Smooth method of the Pitch shifter is derived from (Wide Open License)"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://blogs.zynaptiq.com/bernsee/pitch-shifting-using-the-ft/" />
    </Preference>
    <Preference
        android:title="libsamplerate"
        android:summary="Erik de Castro Lopo: sample rate conversion for impulse responses and Live programmable DSP (BSD 2-clause)"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/libsndfile/libsamplerate" />
    </Preference>
    <Preference
        android:title="dr_wav, dr_flac, dr_mp3"
        android:summary="David Reid: audio file decoding for impulse responses and Live programmable DSP (public domain or MIT-0)"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/mackron/dr_libs" />
    </Preference>
    <Preference
        android:title="Third-party licence texts"
        android:summary="Full copyright notices and licence texts for the components above"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/alienware377/RootlessJamesDSP-ViPER4Android-Edition/blob/viper-extras/THIRD_PARTY_NOTICES.md" />
    </Preference>
    <Preference
        android:title="@string/credits_dattorro"
        android:summary="Jon Dattorro — figure-eight plate reverb topology (Effect Design, JAES 1997), basis of the Plate room type"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://ccrma.stanford.edu/~dattorro/EffectDesignPart1.pdf" />
    </Preference>
    <Preference
        android:title="@string/credits_freeverb"
        android:summary="Jezar at Dreampoint — Freeverb, basis of the Classic ViPER room type"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://ccrma.stanford.edu/~jos/pasp/Freeverb.html" />
    </Preference>
    <Preference
        android:title="@string/credits_zita"
        android:summary="Fons Adriaensen — zita-rev1, reference for the Concert hall FDN topology"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://kokkinizita.linuxaudio.org/linuxaudio/" />
    </Preference>
    <Preference
        android:title="@string/credits_dragonfly"
        android:summary="Michael Willis and contributors — Dragonfly Reverb, reference for the Room early-reflection arrangement"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/michaelwillis/dragonfly-reverb" />
    </Preference>
    <Preference
        android:title="@string/credits_mverb"
        android:summary="Martin Eastwood — MVerb, Dattorro-topology studio reference"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/martineastwood/mverb" />
    </Preference>
    <Preference
        android:title="@string/credits_headsetcontrol"
        android:summary="Sapd and contributors — HeadsetControl, reference for device protocol work"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/Sapd/HeadsetControl" />
    </Preference>

    <Preference
        android:title="@string/credits_viperfxre"
        android:summary="ViPERFX_RE project — reverse-engineered ViPER4Android source, reference for the ViPER classic limiter"
        app:iconSpaceReserved="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/AndroidAudioMods/ViPERFX_RE" />
    </Preference>

    <PreferenceCategory
        android:key="@string/key_translators"
        app:title="@string/translators"
        app:iconSpaceReserved="false" />

</PreferenceCategory>
</PreferenceScreen>